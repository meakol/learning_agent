# 复制为 .env 后填写。也可以在网页右上角“设置”中临时填写。
# 任意 OpenAI 兼容接口均可：OpenAI / DeepSeek / Moonshot / 通义千问 / 智谱 / Ollama ...
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 可选
# OPENAI_TEMPERATURE=0.3
# MAX_CONTEXT_CHARS=24000
# HOST=127.0.0.1
# PORT=8124

# 模型上下文与笔记 Pipeline
# MODEL_CONTEXT_TOKENS=8192
# PIPELINE_ENABLED=true
# PIPELINE_CHUNK_CHARS=6000
# PIPELINE_MAX_PAGES_PER_CHUNK=8
# PIPELINE_CONCURRENCY=2
# PIPELINE_MAX_RETRIES=2

# 计划 / 测试 / 问答超时（秒）；慢模型可继续调大
# PLAN_TIMEOUT_SECONDS=60
# QUIZ_TIMEOUT_SECONDS=120
# CHAT_TIMEOUT_SECONDS=30

# 检索层；默认 keyword，不需要 embedding
# RETRIEVAL_MODE=keyword
# RETRIEVAL_TOP_K=6
# RETRIEVAL_MIN_SCORE=0.0
# BM25_CHUNK_CHARS=1000
# HYBRID_ALPHA=0.5

# 可选向量模式；local_vector/remote_api/hybrid 才需要
# EMBEDDING_BASE_URL=
# EMBEDDING_MODEL=
# EMBEDDING_API_KEY=
# EMBEDDING_MAX_TOKENS=
# EMBEDDING_DEVICE=cpu
# EMBEDDING_BATCH_SIZE=16

# 日志
# LOG_LEVEL=INFO
